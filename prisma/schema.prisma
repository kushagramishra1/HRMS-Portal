generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Employee {
  id           Int          @id @default(autoincrement())
  employeeCode String       @unique
  firstName    String
  lastName     String
  email        String       @unique
  phone        String?
  department   String
  designation  String
  joinDate     DateTime
  status       EmployeeStatus @default(ACTIVE)
  salary       Float?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  attendances  Attendance[]
  leaveRequests LeaveRequest[]
}

model Attendance {
  id         Int               @id @default(autoincrement())
  employeeId Int
  date       DateTime
  checkIn    String?
  checkOut   String?
  status     AttendanceStatus  @default(PRESENT)
  employee   Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  createdAt  DateTime          @default(now())
  @@unique([employeeId, date])
}

model LeaveRequest {
  id         Int         @id @default(autoincrement())
  employeeId Int
  type       LeaveType   @default(CASUAL)
  startDate  DateTime
  endDate    DateTime
  reason     String
  status     LeaveStatus @default(PENDING)
  employee   Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  WORK_FROM_HOME
}

enum LeaveType {
  CASUAL
  SICK
  EARNED
  OTHER
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}
